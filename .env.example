NODE_ENV=development
PORT=3000

# PostgreSQL (local app / docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fastify_be
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fastify_be?schema=public

# JWT (min 16 chars)
JWT_SECRET=change-me-to-a-long-secret
JWT_EXPIRES_IN=7d

# S3 / MinIO (leave S3_ENDPOINT empty for real AWS)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET=fastify-uploads
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_BYTES=5242880

# Demo seed users (after npm run db:seed):
# admin@example.com / Password123!
# user@example.com / Password123!
